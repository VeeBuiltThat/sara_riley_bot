FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/modbot ./cmd/bot

FROM alpine:3.21
RUN addgroup -S app && adduser -S app -G app
WORKDIR /app
COPY --from=build /out/modbot /usr/local/bin/modbot
RUN mkdir -p /app/data && chown -R app:app /app
USER app
CMD ["modbot"]
