
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DASHBOARD_SECRET_KEY=replace-with-a-long-random-secret

# true in production behind HTTPS, false for local http://localhost
SESSION_COOKIE_SECURE=false

# Discord bot
DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_GUILD_ID=

# Local Ollama endpoint used only by the bot (no credentials are required)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Default log channel for new guilds (admins can override per-guild via dashboard)
DEFAULT_LOG_CHANNEL_ID=

# Default role IDs seeded when the bot joins a new guild
DEFAULT_OWNER_ROLE_ID=
DEFAULT_ADMIN_ROLE_ID=
DEFAULT_MOD_ROLE_ID=

# Discord OAuth dashboard login; register this exact redirect URL in the Developer Portal
DISCORD_CLIENT_ID=replace-with-discord-application-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:8501/oauth/callback

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=replace-with-database-password

# Streamlit dashboard
DASHBOARD_PASSWORD=replace-with-dashboard-password
