FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY dashboard/website/requirements.txt ./dashboard/website/requirements.txt
RUN pip install --no-cache-dir -r dashboard/website/requirements.txt
COPY dashboard/website ./dashboard/website
RUN mkdir -p /app/data
EXPOSE 8501
CMD ["gunicorn", "--chdir", "dashboard/website", "--bind", "0.0.0.0:8501", "--workers", "2", "--threads", "4", "--access-logfile", "-", "app:app"]
